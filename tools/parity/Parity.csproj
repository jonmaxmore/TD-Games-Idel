<!-- Runs the Unity client's C# rules (prototypes/unity/Assets/Scripts/Sim, no UnityEngine references) on plain .NET
     against the golden replays generated from the TypeScript sim. No Unity install or license needed, so CI can run it.
     npm run sim:parity   (offline: set NEWTONSOFT_DLL=/path/Newtonsoft.Json.dll instead of restoring from NuGet) -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../prototypes/unity/Assets/Scripts/Sim/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(NEWTONSOFT_DLL)' == ''">
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(NEWTONSOFT_DLL)' != ''">
    <Reference Include="Newtonsoft.Json"><HintPath>$(NEWTONSOFT_DLL)</HintPath></Reference>
  </ItemGroup>
</Project>
