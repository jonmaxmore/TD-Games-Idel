{
  "name": "td-games-idel",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "economy:check": "node tools/economy/check.mjs",
    "progression:check": "node tools/progression/check.mjs",
    "sim:golden": "vite-node packages/sim/scripts/write-golden.ts",
    "art:build": "node tools/blender/build.mjs",
    "art:brief": "node tools/art/brief.mjs",
    "art:pixellab": "node tools/art/pixellab.mjs",
    "art:mockups": "node tools/blender/build.mjs --script tools/art/mockups.py",
    "sim:battle": "vite-node packages/sim/scripts/battle-measure.ts",
    "sim:campaign": "vite-node packages/sim/scripts/campaign-measure.ts",
    "sim:deck": "vite-node packages/sim/scripts/deck-measure.ts",
    "typecheck": "tsc -p packages/sim && tsc -p packages/protocol && tsc -p packages/game && tsc -p packages/client",
    "dev:server": "vite-node packages/game/src/main.ts",
    "dev": "npm run dev -w @five-sects/client",
    "build": "npm run build -w @five-sects/client",
    "shots": "node packages/client/scripts/shots.mjs",
    "shots:pvp": "node packages/client/scripts/shots-pvp.mjs"
  },
  "overrides": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "playwright": "1.56.1",
    "typescript": "5.9.2",
    "vite": "6.3.5",
    "vite-node": "3.2.4",
    "vitest": "3.2.4"
  }
}
