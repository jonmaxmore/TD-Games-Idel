{
  "name": "td-games-idel",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @five-sects/client",
    "build": "npm run build -w @five-sects/client",
    "test": "vitest run",
    "typecheck": "tsc -p packages/sim && tsc -p packages/client",
    "sim:replay": "vite-node packages/sim/scripts/replay.ts --",
    "smoke": "node packages/client/scripts/smoke.mjs",
    "sim:measure": "vite-node packages/sim/scripts/measure.ts --",
    "sim:golden": "vite-node packages/sim/scripts/write-golden.ts",
    "unity:sync": "node prototypes/unity/sync-data.mjs",
    "sim:parity": "dotnet run --project tools/parity -c Release",
    "art:build": "node tools/blender/build.mjs",
    "art:brief": "node tools/art/brief.mjs",
    "art:mockups": "node tools/blender/build.mjs --script tools/art/mockups.py"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "playwright": "1.56.1",
    "typescript": "5.9.2",
    "vite": "6.3.5",
    "vite-node": "3.2.4",
    "vitest": "3.2.4"
  }
}
