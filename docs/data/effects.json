{
  "_notes": "Pixel-art VFX spec. Sprites are crisp pixel art; glow/bloom is a separate additive HD layer on top (HD-2D-lite). Low FX halves particles and disables bloom.",
  "render": {
    "internalResolution": [180, 320],
    "scaling": "integer scale, nearest-neighbour, letterbox",
    "tile": 16,
    "characterSprite": [24, 32],
    "bossSprite": [64, 64],
    "projectile": [8, 8],
    "paletteRule": "48-colour master palette; each sect limited to 6 shades + shared skin/outline",
    "palette": {
      "shared": ["#1A1423", "#F2C9A0", "#C9966E", "#E3B04B", "#D2412F", "#EEF3F8"],
      "metal": ["#E5EAF0", "#D9E1EA", "#9FB3CA", "#6B8AAD", "#486483", "#304357"],
      "wood": ["#9FDCA7", "#5BC46A", "#3DA94C", "#2F833B", "#225F2B", "#173F1D"],
      "water": ["#ABDBFF", "#4FB3FF", "#0C96FF", "#0076CF", "#005596", "#003964"],
      "fire": ["#FF9E7B", "#FF5A1F", "#E53C00", "#B12F00", "#812200", "#561700"],
      "earth": ["#DEC191", "#C99A4A", "#A97D33", "#836127", "#5F471C", "#402F13"],
      "yinyang": ["#F2F2F2", "#C8C4CC", "#8F8A96", "#5A5266", "#3A3442", "#FFFFFF"],
      "enemy": ["#8A2A1A", "#5A1820", "#2A0A10", "#3E5A2A", "#6E6A78", "#120A10"],
      "env": ["#16201A", "#1E2B22", "#24352A", "#3B2C2A", "#4A3833", "#5E4A42", "#7A8C7E", "#C9D3D8"]
    },
    "paletteNote": "shared + one sect group (6 shades each) per sprite; enemies use shared+enemy; terrain uses env. Blender pipeline: docs/tools/blender.md",
    "outline": "1px dark outline #1A1423 on all characters for readability",
    "targetFps": 60, "maxParticles": 1500, "bloom": { "threshold": 0.65, "strength": 0.8 }
  },
  "animations": {
    "disciple": { "idle": 4, "attack": 6, "skill": 8, "levelUp": 6, "fps": 10 },
    "enemy":    { "walk": 6, "hit": 2, "death": 6, "fps": 10 },
    "boss":     { "idle": 6, "attack": 8, "phaseChange": 12, "death": 12, "fps": 12 }
  },
  "sects": {
    "metal": { "projectile": "white crescent sword qi, 3-frame smear",     "impact": "spark cross + 1-frame white flash",     "status": "sword marks (bleed)",               "particles": 12, "sfx": "shing" },
    "wood":  { "projectile": "green needle, leaf trail",                    "impact": "leaf burst",                            "status": "green bubbles (poison stacks 1-3)", "particles": 14, "sfx": "flute note" },
    "water": { "projectile": "blue palm wave (ring)",                       "impact": "splash + ice shards",                   "status": "frost crust, frozen = ice block",   "particles": 16, "sfx": "chime + crack" },
    "fire":  { "projectile": "fan cone of flame pixels",                    "impact": "flame pillar 6 frames",                 "status": "small flames on head",              "particles": 22, "sfx": "whoosh-crackle" },
    "earth": { "projectile": "staff shockwave along ground",                "impact": "rock chunks + dust, 2px screen shake",  "status": "stars (stun)",                       "particles": 14, "sfx": "gong thud" },
    "yinyang": { "projectile": "talisman paper spinning",                   "impact": "taiji symbol pop",                      "status": "revealed: black/white outline",      "particles": 8,  "sfx": "bell" }
  },
  "events": {
    "comboMerge":   { "sequence": "two disciples leap, collide mid-air, ink-brush flash, calligraphy name of technique appears (e.g. 冰剑 / กระบี่เหมันต์)", "timeScale": { "value": 0.2, "duration": 0.25 }, "haptic": "medium", "sfx": "drum hit + guqin chord" },
    "grandmaster":  { "sequence": "full-screen ink wash cut-in portrait 0.8s, then descends", "haptic": "heavy" },
    "crit":         { "hitStopMs": 40, "damageNumber": "pixel font, gold, bounce", "haptic": "light" },
    "bossSpawn":    { "sequence": "red moon fills sky, name banner slides in", "sfx": "war horn" },
    "waveClear":    { "silverFountain": true, "interestPopup": true, "sfx": "coin cascade" },
    "offlineReward":{ "sequence": "disciples meditate, qi orbs flow into gourd, counter rolls", "haptic": "success" }
  },
  "accessibility": { "damageNumbersToggle": true, "screenShakeToggle": true, "flashReduction": true, "colorblind": "each sect has a glyph (金木水火土 + ☯) on projectiles and status icons" }
}
